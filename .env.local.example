# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real keys.

# Groq API key, used server-side only (in /app/api routes) for the diagnosis step.
GROQ_API_KEY=

# Razorpay test-mode credentials, used server-side only for creating test orders/payment retries.
RAZORPAY_KEY_ID=rzp_test_your_key_here
RAZORPAY_KEY_SECRET=

# Separate secret you set when configuring the webhook in the Razorpay test dashboard
# (Settings > Webhooks). NOT the same as RAZORPAY_KEY_SECRET above.
RAZORPAY_WEBHOOK_SECRET=

# Brevo (formerly Sendinblue) transactional email, used only for transactions that
# have a real customerEmail set in data/transactions.json or transactions-seed.json.
# BREVO_SENDER_EMAIL must be a sender address verified in your Brevo account.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=

# Base URL used to build the response links inside recovery emails (Yes/No/Paid
# elsewhere). Defaults to http://localhost:3000 if unset — only needs setting when
# deployed somewhere else.
APP_BASE_URL=http://localhost:3000

# Bounded recovery workflow (lib/recovery-workflow-config.ts) — all optional,
# each falls back to a sensible default if unset. Tune the pace/limits of the
# recovery loop without touching code.
# RECOVERY_MAX_TOTAL_ATTEMPTS=3
# RECOVERY_REMINDER_COOLDOWN_HOURS=6
# RECOVERY_MAX_REMINDERS=2
# RECOVERY_MAX_PAYMENT_RETRIES=2
# RECOVERY_DELAY_BETWEEN_ACTIONS_HOURS=1
# RECOVERY_MAX_DURATION_HOURS=168
